# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code settings (track shared project settings; ignore everything else)
.claude/*
!.claude/settings.json

.worktrees/

# Superpowers runtime/session state (plans + specs live under docs/superpowers/)
.superpowers/

# Rust build artifacts
/target

# DuckDB source clone — reference corpus for the SQL specializer, not a dependency
/duckdb/

# Compiled PyO3 extension modules (built in-place by `maturin develop`)
**/sql_transform/_interpreter*.so
**/sql_transform/_interpreter*.pyd
**/sql_transform/_interpreter*.pdb
**/confit/_engine*.so
**/confit/_engine*.pyd
**/confit/_engine*.pdb

# Differential fuzz harness scratch (candidate logs, repro probes)
scripts/fuzz/output/
